#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        layer-2-mouse_middle_mb {
            bindings = <&mkp MB3>;
            key-positions = <65 70>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &kp PRINTSCREEN                                                     &kp CAPSLOCK   &kp N6  &kp N7          &kp N8        &kp N9         &kp N0             &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &tog 2                                                              &tog 3         &kp Y   &kp U           &kp I         &kp O          &kp P              &kp LEFT_BRACKET
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &kp PG_UP        &kp LCTRL  &kp LEFT_ALT       &kp LGUI  &kp RCTRL  &kp PAGE_DOWN  &kp H   &kp J           &kp K         &kp L          &kp SEMI           &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                               &kp RIGHT_ALT      &tog 1                              &kp N   &kp M           &kp COMMA     &kp DOT        &kp FSLH           &kp RSHFT
&mo 4      &kp EQUAL  &kp NUBS  &kp LEFT  &kp RIGHT          &kp BSPC         &kp DEL    &kp HOME           &kp END   &kp ENTER  &kp SPACE              &kp DOWN_ARROW  &kp UP_ARROW  &kp BACKSLASH  &kp RIGHT_BRACKET  &mo 4
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans          &trans          &trans        &trans           &trans                                            &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans          &trans          &trans        &trans           &none                                             &none     &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans    &trans    &trans      &trans  &trans    &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans          &trans          &trans        &trans                               &trans      &trans                      &trans          &trans          &trans        &trans           &trans  &trans
&none   &trans  &trans          &trans          &trans                         &mkp MB1  &mkp MB4  &trans      &trans  &mkp MB5  &mkp MB2                  &trans          &trans        &trans           &trans  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &trans     &trans  &kp KP_NUM    &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                  &none      &trans  &kp KP_N7     &kp KP_N8      &kp KP_N9        &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp LCTRL  &kp LALT      &kp LGUI  &kp RCTRL  &trans     &trans  &kp KP_N4     &kp KP_N5      &kp KP_N6        &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp RALT      &none                           &trans  &kp KP_N1     &kp KP_N2      &kp KP_N3        &kp KP_ENTER  &trans
&none   &trans  &trans  &trans  &trans          &kp BSPC  &kp DEL    &kp HOME      &kp END   &kp ENTER  &kp KP_N0          &kp UP_ARROW  &kp DOWN       &kp KP_DOT       &kp KP_ENTER  &trans
            >;
        };

        media {
            bindings = <
&trans  &trans         &trans              &trans                &trans               &trans  &trans                                      &trans  &trans          &trans             &trans      &trans           &trans         &trans
&trans  &trans         &kp LG(C_PREVIOUS)  &trans                &kp LG(C_NEXT)       &trans  &none                                       &trans  &trans          &trans             &trans      &trans           &trans         &trans
&trans  &kp LS(LC(D))  &kp C_PREV          &kp C_PLAY_PAUSE      &kp C_NEXT           &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp LG(C_MUTE)  &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &kp LS(LC(M))  &trans
&trans  &trans         &kp LG(C_VOL_DN)    &kp LG(C_PLAY_PAUSE)  &kp LG(C_VOLUME_UP)  &trans                  &trans      &none                   &trans          &trans             &trans      &trans           &trans         &trans
&none   &trans         &trans              &trans                &trans                       &trans  &trans  &trans      &trans  &trans  &trans                  &trans             &trans      &trans           &trans         &none
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &kp F1      &kp F2      &kp F3        &kp F4        &kp F5  &trans                                                  &trans       &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &trans
&trans  &trans      &trans      &trans        &trans        &trans  &bootloader                                             &bootloader  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &bt BT_CLR  &bl BL_TOG  &bl BL_CYCLE  &out OUT_TOG  &trans  &trans       &trans  &kp RIGHT_WIN      &trans  &trans  &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans  &trans      &trans      &trans        &trans        &trans                       &trans             &none                        &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans      &trans        &trans                &kp F11      &trans  &trans             &trans  &trans  &kp F12                    &trans        &trans        &trans        &trans        &trans
            >;
        };
    };
};
